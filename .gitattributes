artifacts/beach-volleyball/public/unity-build/Build/Volleyball_WebGL_Uncompressed_2.data filter=lfs diff=lfs merge=lfs -text

# The Unity WebGL payloads. The .data has always needed LFS (it is past GitHub's
# 100 MB hard limit). The .wasm is ~49 MB, so ordinary git accepted it, but every
# rebuild added another ~49 MB to history permanently and a wasm binary does not
# delta-compress. Tracked by glob rather than by filename so a build renamed in
# future is still covered.
*.wasm filter=lfs diff=lfs merge=lfs -text
