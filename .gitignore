# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/

# Brotli-precompressed Unity WebGL assets - regenerated by
# scripts/compress-unity-data.cjs, not stored in git (500+ MB each).
# See docs/packaging.md.
artifacts/beach-volleyball/public/unity-build/Build/*.br

# Generated by mockupPreviewPlugin at dev-server start — regenerated on every
# run, so it only ever shows up as noise in git status.
artifacts/mockup-sandbox/src/.generated/

# SQLite sidecars — transient, recreated whenever the database is opened.
lib/db/*.sqlite-wal
lib/db/*.sqlite-shm
PR_BODY.md

# Replit's attached-assets drop box. The 1242 files already committed stay
# tracked - .gitignore only affects UNTRACKED files - so the seed scripts in
# scripts/src keep resolving and clone size is unchanged. This only stops NEW
# pastes from being staged, which is where the 2.4 GB came from.
# Untracking the existing files (git rm --cached) is a separate, unmade
# decision: it would break the seed scripts on a fresh clone.
attached_assets/
