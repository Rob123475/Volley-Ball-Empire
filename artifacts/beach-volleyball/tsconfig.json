{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts", "../../lib/replit-auth-web"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "@shared/continents": ["../../lib/db/src/schema/continents.ts"],
      "@shared/staff-roles": ["../../lib/db/src/schema/staff-roles.ts"],
      "@shared/career-difficulty": ["../../lib/db/src/schema/career-difficulty.ts"],
      "@shared/facility-names": ["../../lib/db/src/schema/facility-names.ts"]
    }
  },
  "references": [
    {
      "path": "../../lib/api-client-react"
    }
  ]
}
