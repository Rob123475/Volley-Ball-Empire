<Project Sdk="Microsoft.NET.Sdk">
  <!--
    1.2 Part A: runs the Unity project's played-match engine (Assets/Scripts/PlayedMatch/*.cs)
    and its checks (Assets/Editor/PlayedMatchChecks.cs and PlayedMatchSims.cs), compiled from
    the Unity repo as they are, so the harness tests the court's own code, not a copy.
    Path overridable: dotnet run -p:UnityRepo=...
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UnityRepo Condition="'$(UnityRepo)' == ''">C:\Users\rbonn\Game_Dev\VolleyBall Empire\volleyball</UnityRepo>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UnityRepo)\Assets\Scripts\PlayedMatch\*.cs" LinkBase="PlayedMatch" />
    <Compile Include="$(UnityRepo)\Assets\Scripts\PointModel.cs" Link="PointModel.cs" />
    <Compile Include="$(UnityRepo)\Assets\Editor\PlayedMatchChecks.cs" Link="PlayedMatchChecks.cs" />
    <Compile Include="$(UnityRepo)\Assets\Editor\PlayedMatchSims.cs" Link="PlayedMatchSims.cs" Condition="Exists('$(UnityRepo)\Assets\Editor\PlayedMatchSims.cs')" />
  </ItemGroup>
</Project>
