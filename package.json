{
  "name": "workspace",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "preinstall": "sh -c 'rm -f package-lock.json yarn.lock; case \"$npm_config_user_agent\" in pnpm/*) ;; *) echo \"Use pnpm instead\" >&2; exit 1 ;; esac'",
    "build": "pnpm run typecheck && pnpm -r --if-present run build && pnpm run sync:public && pnpm run test:harness",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run check:writes && pnpm run check:starter-db && pnpm run check:continents && pnpm run check:roster && pnpm run check:build-env && pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "electron:dev": "electron .",
    "electron:build": "electron-builder",
    "check:writes": "node scripts/check-write-boundaries.cjs",
    "check:starter-db": "node scripts/check-starter-db.cjs",
    "check:continents": "node scripts/check-continents.cjs",
    "check:roster": "node scripts/check-roster.cjs",
    "check:build-env": "node scripts/check-build-env.mjs",
    "test:harness": "node harness/run-all.mjs",
    "sync:public": "node scripts/sync-public.cjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "node-gyp": "12.3.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  },
  "build": {
    "appId": "com.volleyballempire.desktop",
    "productName": "Volleyball Empire",
    "beforePack": "scripts/before-pack.cjs",
    "directories": {
      "output": "C:\\build\\vbe"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "artifacts/api-server/dist",
        "to": "server/dist",
        "filter": ["**/*", "!public/**"]
      },
      {
        "from": "artifacts/beach-volleyball/dist/public",
        "to": "public"
      },
      {
        "from": "lib/db/volleyball-empire.sqlite",
        "to": "starter-db/volleyball-empire.sqlite"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/icons/volleyball-empire.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
